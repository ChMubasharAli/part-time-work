generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// Task-9 Models
model Task9PatientPersonal {
  id         Int      @id @default(autoincrement())
  fullName   String
  gender     String
  dateOfBirth DateTime
  age        Int
  cnic       String   @unique
  maritalStatus String
  bloodGroup String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  contact     Task9PatientContact?
  medical     Task9PatientMedical?
  visits      Task9PatientVisit[]
}

model Task9PatientContact {
  id              Int      @id @default(autoincrement())
  patientId       Int      @unique
  phoneNumber     String
  emergencyContact String
  email          String
  address        String
  city           String
  createdAt      DateTime @default(now())
  
  // Relations
  patient        Task9PatientPersonal @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Task9PatientMedical {
  id                Int      @id @default(autoincrement())
  patientId         Int      @unique
  chronicDiseases   String[]
  pastSurgeries     String[]
  currentConditions String[]
  createdAt        DateTime @default(now())
  
  // Relations
  patient          Task9PatientPersonal @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Task9PatientVisit {
  id          Int      @id @default(autoincrement())
  patientId   Int
  visitType   String   // OPD / Emergency / Follow-up
  reason      String
  assignedDoctor String
  createdAt   DateTime @default(now())
  
  // Relations
  patient     Task9PatientPersonal @relation(fields: [patientId], references: [id], onDelete: Cascade)
}